# Auth.js / NextAuth v5 — generate with: `npx auth secret`
AUTH_SECRET=

# GitHub OAuth App (https://github.com/settings/developers)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Claude — used to generate the bio and project descriptions
ANTHROPIC_API_KEY=

# Optional. Used for all GitHub REST/GraphQL calls (the app does not send the
# user's OAuth token). Required to fetch pinned repos.
GITHUB_TOKEN=
